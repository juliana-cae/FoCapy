<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/focapy_widget_background" android:orientation="vertical" android:padding="14dp">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FoCapy · foco rápido" android:textColor="#15382E" android:textSize="17sp" android:textStyle="bold" />
 <TextView android:id="@+id/focus_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="PRONTO PARA COMEÇAR" android:textColor="#647067" android:textSize="11sp" android:textStyle="bold" />
 <Chronometer android:id="@+id/focus_widget_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_horizontal" android:textColor="#15382E" android:textSize="28sp" android:textStyle="bold" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
  <TextView android:id="@+id/focus_widget_start" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/focapy_widget_primary_button" android:gravity="center" android:text="▶  Foco" android:textColor="#FFFDF8" android:textSize="13sp" android:textStyle="bold"/>
  <TextView android:id="@+id/focus_widget_stopwatch" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/focapy_widget_secondary_button" android:gravity="center" android:text="◷  Cronômetro" android:textColor="#15382E" android:textSize="12sp" android:textStyle="bold"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="end" android:orientation="horizontal">
  <TextView android:id="@+id/focus_widget_pause" android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/focapy_widget_secondary_button" android:gravity="center" android:paddingHorizontal="14dp" android:text="Pausar" android:textColor="#15382E" android:textSize="12sp" android:textStyle="bold"/>
  <TextView android:id="@+id/focus_widget_reset" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:background="@drawable/focapy_widget_secondary_button" android:gravity="center" android:paddingHorizontal="14dp" android:text="Encerrar" android:textColor="#15382E" android:textSize="12sp" android:textStyle="bold"/>
 </LinearLayout>
</LinearLayout>
