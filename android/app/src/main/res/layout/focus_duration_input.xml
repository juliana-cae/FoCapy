<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="#FFFDF8" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duração do foco"
        android:textColor="#15382E" android:textSize="20sp" android:textStyle="bold" />
    <EditText android:id="@+id/focus_duration_minutes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:hint="Minutos" android:imeOptions="actionDone" android:inputType="number"
        android:maxLength="3" android:selectAllOnFocus="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="De 1 a 480 minutos"
        android:textColor="#647067" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="end" android:orientation="horizontal">
        <Button android:id="@+id/focus_duration_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancelar" />
        <Button android:id="@+id/focus_duration_save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Salvar" />
    </LinearLayout>
</LinearLayout>
